{
  "expo": {
    "name": "Amipay",
    "slug": "Amipay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/amypay-logo.png",
    "scheme": "amipay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.amipay"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android/mipmap-xxxhdpi/ic_launcher.png",
        "monochromeImage": "./assets/images/android/mipmap-xxxhdpi/ic_launcher.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.amipay"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/amypay-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/amypay-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/amypay-logo.png",
            "backgroundColor": "#161616"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c885e201-40ed-4b58-8fbb-90cc2e493a55"
      }
    }
  }
}
