#Stage 1 — Builder  (full Rust toolchain + system build deps)
FROM rust:latest AS builder

# Diesel (postgres) needs the native libpq headers at compile time
RUN apt-get update && \
  apt-get install -y libpq-dev pkg-config && \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

#Copy only the contract crate (needed for IDL types, no-entrypoint) ───
COPY contract/programs/contract/ /app/contract/programs/contract/
COPY contract/Cargo.toml         /app/contract/Cargo.toml

#Copy the backend source 
COPY backend/Cargo.toml backend/Cargo.lock /app/backend/
COPY backend/src/                          /app/backend/src/
COPY backend/migrations/                   /app/backend/migrations/
COPY backend/diesel.toml                   /app/backend/diesel.toml

#Build the release binary
WORKDIR /app/backend
RUN cargo build --release

#  Stage 2 — Runtime  (slim image, just the compiled binary)
FROM debian:trixie-slim

# Only the runtime libpq + TLS certs for HTTPS calls (DeepSeek, Solana RPC, Neon DB)
RUN apt-get update && \
  apt-get install -y libpq5 ca-certificates && \
  rm -rf /var/lib/apt/lists/*

# Copy the compiled binary from the builder
COPY --from=builder /app/backend/target/release/backend /usr/local/bin/backend

# Create a directory for optional volume mounts (e.g. Solana keypair)
RUN mkdir -p /app

WORKDIR /app
EXPOSE 9000

CMD ["backend"]
