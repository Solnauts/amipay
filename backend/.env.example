# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# JWT Authentication
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_strong_random_secret

# Solana Configuration
SOLANA_PROGRAM_ID=YOUR_PROGRAM_ID_HERE
SOLANA_USDC_MINT=YOUR_USDC_MINT_ADDRESS_HERE
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Payer Keypair
# ⚠ This is NOT a file path — paste the raw JSON byte array from your keypair file directly.
# Example: [12,34,56,78,...]
SOLANA_KEYPAIR_PATH=[12,34,56,78,...]

# Solana Seeds (must match on-chain contract seeds exactly)
SOLANA_SEED_MAIN_STATE=main_state
SOLANA_SEED_USER_USDC_ATA=user_usdc_ata

# AI Configuration (DeepSeek / OpenAI-compatible)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
